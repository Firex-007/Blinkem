lay:flex;align-items:center;gap:8px;font-weight:800;font-size:18px;letter-spacing:-.02em}.logo{width:32px;height:32px;border-radius:10px;background:var(--primary);color:white;display:grid;place-items:center}.role{height:36px;padding:0 12px;border-radius:999px;background:var(--primarySoft);color:var(--primary);font-size:12px;font-weight:800}\n.area-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.area{display:flex;align-items:center;gap:7px;font-weight:700}.area .icon{font-size:18px;color:var(--primary)}\n.console{padding:18px;margin-bottom:24px}.console-title{font-size:28px;line-height:1.08;letter-spacing:-.03em;font-weight:800;max-width:290px}.helper{margin-top:8px;color:var(--muted);font-size:14px}.actions{display:flex;gap:10px;align-items:center;margin:18px 0}.primary{height:48px;border-radius:14px;background:var(--primary);color:white;padding:0 16px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:8px}.secondary{height:48px;border-radius:14px;background:var(--primarySoft);color:var(--primary);padding:0 16px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:8px}.orb{width:60px;height:60px;border-radius:50%;background:var(--primary);color:#fff;display:grid;place-items:center;box-shadow:0 8px 18px rgba(31,91,255,.28)}.orb .icon{font-size:26px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.cat{min-height:76px;background:var(--surface2);border-radius:14px;padding:10px 4px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:12px;font-weight:700;text-align:center}.cat .icon{color:var(--primary);font-size:20px}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.section-title{font-size:17px;font-weight:800}.select{height:40px;border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:0 10px;color:var(--primary);font-weight:800;font-size:13px}.rail{display:flex;gap:10px;overflow:hidden}.worker{min-width:168px;padding:14px}.avatar{width:48px;height:48px;border-radius:50%;background:var(--primary);color:#fff;display:grid;place-items:center;font-weight:800}.worker-name{font-weight:800;margin-top:10px;display:flex;align-items:center;gap:5px}.worker-meta{color:var(--muted);font-size:13px;margin-top:4px}.worker-foot{display:flex;justify-content:space-between;align-items:end;margin-top:12px}.price{font-size:15px;font-weight:800}.eta{background:#FFF2C9;color:#3A2A00;border-radius:999px;padding:5px 8px;font-size:12px;font-weight:800}.reassure{margin-top:16px;padding:14px 0;border-top:1px solid var(--line);color:var(--muted);font-size:13px}.dock{position:absolute;left:12px;right:12px;bottom:12px;height:66px;background:var(--surface);border:1px solid var(--line);border-radius:20px;display:flex;align-items:center;justify-content:space-around;padding:7px}.tab{height:50px;min-width:86px;border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--muted);font-size:12px;font-weight:700}.tab.active{background:var(--primarySoft);color:var(--primary)}.booking{position:absolute;left:16px;right:16px;bottom:88px;background:var(--primary);color:#fff;border-radius:18px;padding:12px;display:flex;align-items:center;gap:10px;box-shadow:0 8px 24px rgba(31,91,255,.25)}.booking .avatar{width:36px;height:36px;background:rgba(255,255,255,.2);font-size:12px}.booking-copy{flex:1}.booking-copy strong{display:block;font-size:13px}.booking-copy span{font-size:12px;opacity:.82}\n\n</style>\n<div class=\"app\" data-kid=\"1\">\n  <div class=\"header\" data-name=\"utility header\" data-kid=\"1-1\"><div class=\"brand\" data-name=\"brand\" data-kid=\"1-1-1\"><span class=\"logo\" data-kid=\"1-1-1-1\"><i class=\"icon icon-zap\" data-kid=\"1-1-1-1-1\"></i></span><span data-kid=\"1-1-1-2\">Blink'em</span></div><button class=\"role\" data-name=\"demo role switcher\" data-kid=\"1-1-2\">Demo: Customer <i class=\"icon icon-chevron-down\" data-kid=\"1-1-2-1\"></i></button></div>\n  <div class=\"area-row\" data-name=\"location and utilities\" data-kid=\"1-2\"><div class=\"area\" data-kid=\"1-2-1\"><i class=\"icon icon-map-pin\" data-kid=\"1-2-1-1\"></i><span data-kid=\"1-2-1-2\">T. Nagar, Chennai</span><i class=\"icon icon-chevron-down muted\" data-kid=\"1-2-1-3\"></i></div><div style=\"display:flex;gap:8px\" data-kid=\"1-2-2\"><button class=\"icon-btn\" aria-label=\"Language\" data-kid=\"1-2-2-1\"><span class=\"tiny\" style=\"font-weight:800;color:var(--primary)\" data-kid=\"1-2-2-1-1\">EN</span></button><button class=\"icon-btn\" aria-label=\"Theme\" data-kid=\"1-2-2-2\"><i class=\"icon icon-moon\" data-kid=\"1-2-2-2-1\"></i></button></div></div>\n  <section class=\"surface console\" data-name=\"request console\" data-kid=\"1-3\">\n    <h1 class=\"console-title\" data-name=\"request headline\" data-kid=\"1-3-1\">Tell us what needs fixing.</h1>\n    <p class=\"helper\" data-kid=\"1-3-2\">Speak in Tamil, Hindi or English.</p>\n    <div class=\"actions\" data-kid=\"1-3-3\"><button class=\"orb\" aria-label=\"Speak your request\" data-kid=\"1-3-3-1\"><i class=\"icon icon-mic\" data-kid=\"1-3-3-1-1\"></i></button><button class=\"secondary\" style=\"flex:1\" data-kid=\"1-3-3-2\"><i class=\"icon icon-search\" data-kid=\"1-3-3-2-1\"></i> Type your request</button></div>\n    <div class=\"grid\" data-name=\"service category matrix\" data-kid=\"1-3-4\">\n      <button class=\"cat\" data-kid=\"1-3-4-1\"><i class=\"icon icon-wrench\" data-kid=\"1-3-4-1-1\"></i><span data-kid=\"1-3-4-1-2\">Plumber</span></button><button class=\"cat\" data-kid=\"1-3-4-2\"><i class=\"icon icon-zap\" data-kid=\"1-3-4-2-1\"></i><span data-kid=\"1-3-4-2-2\">Electrician</span></button><button class=\"cat\" data-kid=\"1-3-4-3\"><i class=\"icon icon-sparkles\" data-kid=\"1-3-4-3-1\"></i><span data-kid=\"1-3-4-3-2\">Cleaning</span></button><button class=\"cat\" data-kid=\"1-3-4-4\"><i class=\"icon icon-hammer\" data-kid=\"1-3-4-4-1\"></i><span data-kid=\"1-3-4-4-2\">Carpenter</span></button><button class=\"cat\" data-kid=\"1-3-4-5\"><i class=\"icon icon-paintbrush\" data-kid=\"1-3-4-5-1\"></i><span data-kid=\"1-3-4-5-2\">Painter</span></button><button class=\"cat\" data-kid=\"1-3-4-6\"><i class=\"icon icon-snowflake\" data-kid=\"1-3-4-6-1\"></i><span data-kid=\"1-3-4-6-2\">AC repair</span></button><button class=\"cat\" data-kid=\"1-3-4-7\"><i class=\"icon icon-chef-hat\" data-kid=\"1-3-4-7-1\"></i><span data-kid=\"1-3-4-7-2\">Cook</span></button><button class=\"cat\" data-kid=\"1-3-4-8\"><i class=\"icon icon-plug-zap\" data-kid=\"1-3-4-8-1\"></i><span data-kid=\"1-3-4-8-2\">Appliance</span></button>\n    </div>\n  </section>\n  <div class=\"section-head\" data-kid=\"1-4\"><h2 class=\"section-title\" data-kid=\"1-4-1\">Available near you</h2><button class=\"select\" data-kid=\"1-4-2\">Plumber <i class=\"icon icon-chevron-down\" data-kid=\"1-4-2-1\"></i></button></div>\n  <div class=\"rail\" data-name=\"nearby worker rail\" data-kid=\"1-5\"><article class=\"surface worker\" data-kid=\"1-5-1\"><div class=\"avatar\" data-kid=\"1-5-1-1\">MK</div><div class=\"worker-name\" data-kid=\"1-5-1-2\">Muthu K <i class=\"icon icon-badge-check\" style=\"font-size:16px;color:var(--success)\" data-kid=\"1-5-1-2-1\"></i></div><div class=\"worker-meta\" data-kid=\"1-5-1-3\">★ 4.8 · 1.4 km · 140 jobs</div><div class=\"worker-foot\" data-kid=\"1-5-1-4\"><span class=\"price\" data-kid=\"1-5-1-4-1\">from ₹299</span><span class=\"eta\" data-kid=\"1-5-1-4-2\">9 min</span></div></article><article class=\"surface worker\" data-kid=\"1-5-2\"><div class=\"avatar\" style=\"background:#3F7AF4\" data-kid=\"1-5-2-1\">RP</div><div class=\"worker-name\" data-kid=\"1-5-2-2\">Ramesh P <i class=\"icon icon-badge-check\" style=\"font-size:16px;color:var(--success)\" data-kid=\"1-5-2-2-1\"></i></div><div class=\"worker-meta\" data-kid=\"1-5-2-3\">★ 4.9 · 2.1 km · 210 jobs</div><div class=\"worker-foot\" data-kid=\"1-5-2-4\"><span class=\"price\" data-kid=\"1-5-2-4-1\">from ₹399</span><span class=\"eta\" data-kid=\"1-5-2-4-2\">12 min</span></div></article></div>\n  <p class=\"reassure\" data-kid=\"1-6\">Workers send their own quote after you describe the job.</p>\n  <div class=\"booking\" data-name=\"active booking continuation\" data-kid=\"1-7\"><div class=\"avatar\" data-kid=\"1-7-1\">MK</div><div class=\"booking-copy\" data-kid=\"1-7-2\"><strong data-kid=\"1-7-2-1\">Muthu is on the way</strong><span data-kid=\"1-7-2-2\">Arrives in ~6 min</span></div><i class=\"icon icon-chevron-right\" data-kid=\"1-7-3\"></i></div>\n  <nav class=\"dock\" data-name=\"main navigation\" data-kid=\"1-8\"><div class=\"tab active\" data-kid=\"1-8-1\"><i class=\"icon icon-house\" data-kid=\"1-8-1-1\"></i><span data-kid=\"1-8-1-2\">Home</span></div><div class=\"tab\" data-kid=\"1-8-2\"><i class=\"icon icon-calendar-days\" data-kid=\"1-8-2-1\"></i><span data-kid=\"1-8-2-2\">Bookings</span></div><div class=\"tab\" data-kid=\"1-8-3\"><i class=\"icon icon-user-round\" data-kid=\"1-8-3-1\"></i><span data-kid=\"1-8-3-2\">Account</span></div></nav>\n</div>",
